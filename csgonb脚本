local function FindSilentTarget()
    Camera = Workspace.CurrentCamera
    if not Camera or not LocalPlayer.Character then 
        getgenv().ParsaSilentTarget = nil 
        return nil
    end
    
    local screenCenter = Camera.ViewportSize / 2
    local closestDist = math.huge
    local closestPart = nil

    -- 遍历所有人
    for _, player in next, Players:GetPlayers() do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char or char:GetAttribute("Dead") then continue end
        
        -- 优先找头，没头找身体
        local targetPart = char:FindFirstChild(Settings.HitPart) or char:FindFirstChild("Head") or char.PrimaryPart
        if not targetPart then continue end

        -- 只要屏幕上看得到
        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if onScreen then
            -- 计算离屏幕中心的像素距离
            local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
            -- 谁最近锁谁，无队友判断，无穿墙判断，无视野范围限制
            if distFromCenter < closestDist then
                closestDist = distFromCenter
                closestPart = targetPart
            end
        end
    end
    getgenv().ParsaSilentTarget = closestPart
    return closestPart
end

-- 原版 Hook
task.spawn(function()
    if typeof(hookfunction) ~= "function" or typeof(getgc) ~= "function" then return end
    local bulletClass = nil
    for attempt = 1, 45 do
        for _, obj in next, getgc(true) do 
            if type(obj) == "table" and typeof(rawget(obj, "_performRaycast")) == "function" and rawget(obj, "getTrueSpread") ~= nil then 
                bulletClass = obj; break 
            end 
        end
        if bulletClass then break end
        task.wait(0.5)
    end

    if bulletClass then
        print("[红星中心] ✅ 纯正原版 Hook 成功！")
        local oldRaycast
        oldRaycast = hookfunction(bulletClass._performRaycast, function(...)
            local returns = table.pack(oldRaycast(...))
            local result = returns[1]
            local SilentTarget = getgenv().ParsaSilentTarget

            if type(result) == "table" then
                pcall(function()
                    local origin = rawget(result, "Origin") or (Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.Position)
                    local targetPos = nil
                    if Settings.SilentEnabled and SilentTarget and SilentTarget.Parent then targetPos = SilentTarget.Position
                    else
                        local hits = rawget(result, "Hits")
                        if type(hits) == "table" and #hits > 0 and hits[#hits] and hits[#hits].Position then targetPos = hits[#hits].Position
                        elseif rawget(result, "Direction") and origin then targetPos = origin + (result.Direction * (result.Distance or 500)) end
                    end

                    -- 画线
                    if origin and targetPos and Settings.BulletTracers then
                        local distance = (targetPos - origin).Magnitude
                        if distance > 0.2 then
                            local beamPart = Instance.new("Part")
                            beamPart.Name = "ParsaBulletTracer"; beamPart.Anchored = true; beamPart.CanCollide = false; beamPart.CastShadow = false
                            beamPart.Material = Enum.Material.Neon; beamPart.Color = Settings.TracerColor; beamPart.Transparency = 0.15
                            beamPart.Size = Vector3.new(0.15, 0.15, distance); beamPart.CFrame = CFrame.new(origin, targetPos) * CFrame.new(0, 0, -distance / 2); beamPart.Parent = Workspace
                            TweenService:Create(beamPart, TweenInfo.new(1, Enum.EasingStyle.Quad), { Transparency = 1 }):Play()
                            task.delay(1, function() if beamPart then beamPart:Destroy() end end)
                        end
                    end

                    -- 篡改弹道
                    if Settings.SilentEnabled and SilentTarget and SilentTarget.Parent then
                        local hits = rawget(result, "Hits")
                        if type(hits) ~= "table" then return end
                        local aimPos = SilentTarget.Position; local lastIndex = nil
                        for index, hit in pairs(hits) do if type(hit) == "table" then if lastIndex == nil or index > lastIndex then lastIndex = index end end end
                        local finalHit = lastIndex and hits[lastIndex]
                        if type(finalHit) ~= "table" then return end
                        finalHit.Instance = SilentTarget; finalHit.Position = aimPos; if finalHit.Exit ~= nil then finalHit.Exit = false end
                        
                        if typeof(origin) == "Vector3" then 
                            local delta = aimPos - origin; local length = delta.Magnitude
                            if length > 0.001 then
                                result.Distance = length; result.Direction = delta.Unit
                                local unit = delta.Unit
                                for index, hit in pairs(hits) do
                                    if index ~= lastIndex and type(hit) == "table" and typeof(hit.Position) == "Vector3" then
                                        local along = (hit.Position - origin):Dot(unit)
                                        if along > length then hit.Position = origin + unit * (length * 0.5) end
                                    end
                                end
                            end
                        end
                    end
                end)
            end
            return table.unpack(returns, 1, returns.n)
        end)
    else
        warn("[红星中心] ❌ 找不到子弹类，Hook 失败！")
    end
end)

