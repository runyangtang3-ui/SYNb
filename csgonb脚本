local partChamsCache = {}
RunService.RenderStepped:Connect(function()
    pcall(function()
        Camera = Workspace.CurrentCamera
        if not Camera or not LocalPlayer.Character then return end
        
        -- 全速寻敌
        FindSilentTarget()

        -- 夜视
        if Settings.NightMode then Lighting.ClockTime = 0; Lighting.Brightness = 2
        else Lighting.ClockTime = 14; Lighting.Brightness = 3 end

        -- 透视
        if Settings.ChamsEnabled then
            for _, player in ipairs(Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                local char = player.Character
                if char and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").Health > 0 then
                    if not partChamsCache[player] then partChamsCache[player] = {} end
                    for _, child in ipairs(char:GetChildren()) do
                        if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" and child.Transparency < 0.99 then
                            local adornment = partChamsCache[player][child]
                            if not adornment or not adornment.Parent then
                                if adornment then adornment:Destroy() end
                                adornment = Instance.new("BoxHandleAdornment")
                                adornment.Name = "Cham_"; adornment.AlwaysOnTop = true; adornment.ZIndex = 10; adornment.Parent = child
                                partChamsCache[player][child] = adornment
                            end
                            adornment.Adornee = child; adornment.Size = child.Size; adornment.Color3 = Settings.ChamsColor; adornment.Transparency = 0.3; adornment.Visible = true
                        end
                    end
                end
            end
        else
            for p, pm in pairs(partChamsCache) do for _, a in pairs(pm) do if a then a:Destroy() end end end; partChamsCache = {}
        end
    end)
end)

