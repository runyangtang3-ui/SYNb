-- 在 GC 中查找游戏的瞄准方向函数
local findAimFunction = function()
    if typeof(filtergc) == "function" then
        local success, res = pcall(function()
            return filtergc("function", {Name = "GetAimDirection"})
        end)
        if success and res and res[1] then return res[1] end
    end
    if typeof(getgc) == "function" then
        local gc = getgc()
        for i = 1, #gc do
            local v = gc[i]
            if typeof(v) == "function" and not checkcaller() then
                local info = debug.getinfo(v)
                local name = info.name or ""
                if string.lower(name):find("aimdirection") or name == "GetAim" or name == "getAim" then
                    return v
                end
                if typeof(debug.getconstants) == "function" then
                    local constants = debug.getconstants(v)
                    if table.find(constants, "GetAimDirection") or (table.find(constants, "FireServer") and table.find(constants, "Unit")) then
                        return v
                    end
                end
            end
        end
    end
    return nil
end

-- 安装静默自瞄 Hook
local function applySilentAimHook()
    local targetFunc = findAimFunction()
    if not targetFunc or targetFunc == main_utils.GetAimDirection then return end
    main_utils.GetAimDirection = targetFunc
    pcall(function()
        main_utils.hook = hookfunction(main_utils.GetAimDirection, function(...)
            if Fluent.Options.SilentAim and Fluent.Options.SilentAim.Value then
                local target = main_utils:GetClosestPlayer() or main_utils.target
                if target then
                    local char = main_utils.LocalPlayer.Character
                    local head = char and char:FindFirstChild("Head")
                    if head then
                        return (target.Position - head.Position).Unit, head.Position
                    end
                end
            end
            return main_utils.hook(...)
        end)
    end)
end

