-- 判断实例是否属于当前地图的可射击物体
local function isShootableObject(instance)
    if not instance then return false end
    local currentMap = main_utils.Workspace:FindFirstChild("CurrentMap")
    local shootableFolder = currentMap and currentMap:FindFirstChild("Shootable")
    if shootableFolder then
        return instance:IsDescendantOf(shootableFolder) or instance == shootableFolder
    end
    return false
end

-- 射线穿透检测：遇到可射击遮挡物时继续向外投射
local function castPierceRay(origin, targetPos, ignoreList)
    local maxAttempts = 3
    local currentOrigin = origin
    local currentIgnore = {unpack(ignoreList)}

    for i = 1, maxAttempts do
        local direction = targetPos - currentOrigin
        if direction.Magnitude < 0.1 then return true end

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = currentIgnore
        params.IgnoreWater = true

        local result = main_utils.Workspace:Raycast(currentOrigin, direction, params)
        if not result or not result.Instance then
            return true
        end

        local hitPart = result.Instance
        local model = hitPart:FindFirstAncestorOfClass("Model")
        local hitPlayer = model and main_utils.Players:GetPlayerFromCharacter(model)

        if hitPlayer then
            return true
        end

        if isShootableObject(hitPart) then
            table.insert(currentIgnore, hitPart)
            currentOrigin = result.Position + (direction.Unit * 0.05)
        else
            return false
        end
    end
    return false
end

-- 判断目标是否可见
main_utils.isVisible = function(self, t)
    local cam = self.Camera
    local lp = self.LocalPlayer
    local char = lp and lp.Character
    if not cam or not char then return false end
    
    local localHrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    if not localHrp then return false end
    
    local camOrigin = cam.CFrame.Position
    local bodyOrigin = localHrp.Position
    local targetPos = t.Position

    if castPierceRay(camOrigin, targetPos, {char}) then
        if castPierceRay(bodyOrigin, targetPos, {char}) then
            return true
        end
    end
    return false
end

-- 预判可见性检测：结合目标速度预判位置
main_utils.isPredictivelyVisible = function(self, head, hrp)
    if not (Fluent.Options.WallCheck and Fluent.Options.WallCheck.Value) then
        return true
    end

    if self:isVisible(head) then 
        return true 
    end

    local velocity = hrp.AssemblyLinearVelocity
    if velocity.Magnitude < 5 then return false end 

    local predictedPosition = head.Position + (velocity * 0.18)
    
    local cam = self.Camera
    local lp = self.LocalPlayer
    local char = lp and lp.Character
    if not cam or not char then return false end
    
    local localHrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    if not localHrp then return false end

    local camOrigin = cam.CFrame.Position
    local bodyOrigin = localHrp.Position
    
    if castPierceRay(camOrigin, predictedPosition, {char}) then
        if castPierceRay(bodyOrigin, predictedPosition, {char}) then
            return true
        end
    end
    return false
end

-- 获取距离最近的可攻击玩家
main_utils.GetClosestPlayer = function(self)
    local lp = self.LocalPlayer
    if not lp then return nil end
    
    local lpChar = lp.Character
    local lpRoot = lpChar and (lpChar:FindFirstChild("HumanoidRootPart") or lpChar:FindFirstChild("Head"))
    if not lpRoot then return nil end
    
    local closestDistance = math_huge
    local closest = nil

    local teamCheck = Fluent.Options.TeamCheck and Fluent.Options.TeamCheck.Value
    local myTeam = teamCheck and lp.Team and lp.Team.Name
    
    local allPlayers = self.Players:GetPlayers()
    local lpPos = lpRoot.Position

    for i = 1, #allPlayers do
        local v = allPlayers[i]
        if v == lp then continue end
        
        local char = v.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        if teamCheck and myTeam and myTeam ~= "" then
            local theirTeam = v.Team and v.Team.Name
            if myTeam == theirTeam then continue end
        end

        local head = char:FindFirstChild("Head")
        if not head then continue end
        
        local distance = (hrp.Position - lpPos).Magnitude
        if distance < closestDistance then
            if not self:isPredictivelyVisible(head, hrp) then continue end
            closestDistance = distance
            closest = head
        end
    end

    return closest
end

-- 创建玩家 3D 透视框
local function create3DEsp(p)
    local id = "esp_" .. p.UserId
    local g = container:FindFirstChild(id) or Instance.new("Folder")
    g.Name = id
    g.Parent = container

    local cache = {}
    local terrain = main_utils.Workspace:FindFirstChildOfClass("Terrain")

    for _, pair in pairs(edges) do
        local name = pair[1] .. pair[2]
        
        -- 外描边（黑色）
        local out = g:FindFirstChild(name .. "_o") or Instance.new("LineHandleAdornment")
        out.Name = name .. "_o"
        out.Thickness = 2.4 
        out.AlwaysOnTop = true
        out.ZIndex = 1
        out.Color3 = Color3_fromRGB(0, 0, 0)
        out.Adornee = terrain
        out.Parent = g

        -- 主线条
        local main = g:FindFirstChild(name .. "_m") or Instance.new("LineHandleAdornment")
        main.Name = name .. "_m"
        main.Thickness = 1.8 
        main.AlwaysOnTop = true
        main.ZIndex = 2
        main.Color3 = Color3_fromRGB(255, 255, 255)
        main.Adornee = terrain
        main.Parent = g

        cache[name] = {m = main, o = out}
    end

    local hl = g:FindFirstChild("EspHighlight") or Instance.new("Highlight")
    hl.Name = "EspHighlight"
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0.2
    hl.OutlineColor = Color3_fromRGB(0, 0, 0)
    hl.Enabled = false
    hl.Parent = g

    local bb = g:FindFirstChild("TagGui") or Instance.new("BillboardGui")
    bb.Name = "TagGui"
    bb.Size = UDim2.new(0, 100, 0, 20)
    bb.AlwaysOnTop = true
    bb.Parent = g

    local tagLabel = bb:FindFirstChild("TagLabel") or Instance.new("TextLabel")
    tagLabel.Name = "TagLabel"
    tagLabel.Size = UDim2.new(1, 0, 1, 0)
    tagLabel.BackgroundTransparency = 1
    tagLabel.TextColor3 = Color3_fromRGB(255, 255, 255)
    tagLabel.TextSize = 12
    tagLabel.Font = Enum.Font.SourceSansBold
    tagLabel.TextStrokeTransparency = 0
    tagLabel.TextStrokeColor3 = Color3_fromRGB(0, 0, 0)
    tagLabel.Parent = bb

    -- 每帧刷新透视显示
    local function step()
        local espMaster = Fluent.Options.EspMaster and Fluent.Options.EspMaster.Value
        local char = p.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and char:FindFirstChild("Head")
        local lpChar = main_utils.LocalPlayer.Character
        local localHrp = lpChar and (lpChar:FindFirstChild("HumanoidRootPart") or lpChar:FindFirstChild("Head"))
        if espMaster and root and hum and hum.Health > 0 and head and localHrp then
            local cf = root.CFrame
            local extentsSize = char:GetExtentsSize()
            local s = Vector3_new(extentsSize.X * 1.1, extentsSize.Y * 0.95, extentsSize.Z * 1.1) / 2
            local pts = {
                f1 = (cf * CFrame_new(-s.X,  s.Y,  s.Z)).Position,
                f2 = (cf * CFrame_new( s.X,  s.Y,  s.Z)).Position,
                f3 = (cf * CFrame_new( s.X, -s.Y,  s.Z)).Position,
                f4 = (cf * CFrame_new(-s.X, -s.Y,  s.Z)).Position,
                b1 = (cf * CFrame_new(-s.X,  s.Y, -s.Z)).Position,
                b2 = (cf * CFrame_new( s.X,  s.Y, -s.Z)).Position,
                b3 = (cf * CFrame_new( s.X, -s.Y, -s.Z)).Position,
                b4 = (cf * CFrame_new(-s.X, -s.Y, -s.Z)).Position
            }
            local currentTarget = (main_utils.target and main_utils.target.Parent == char)
            local targetCol = Fluent.Options.TargetColor and Fluent.Options.TargetColor.Value or Color3_fromRGB(255, 0, 0)
            local espCol = Fluent.Options.EspColor and Fluent.Options.EspColor.Value or Color3_fromRGB(255, 255, 255)
            local baseColor = currentTarget and targetCol or espCol
            local distance = math.floor((root.Position - localHrp.Position).Magnitude)
            local showBox = Fluent.Options.EspBox and Fluent.Options.EspBox.Value

            for _, pair in pairs(edges) do
                local name = pair[1] .. pair[2]
                local c = cache[name]
                if showBox then
                    local p1, p2 = pts[pair[1]], pts[pair[2]]
                    local look = CFrame_new(p1, p2)
                    local mag = (p1 - p2).Magnitude
                    c.m.CFrame, c.o.CFrame = look, look
                    c.m.Length, c.o.Length = mag, mag
                    c.m.Color3 = baseColor
                    c.m.Visible, c.o.Visible = true, true
                else
                    c.m.Visible, c.o.Visible = false, false
                end
            end

            -- 模型高亮
            if Fluent.Options.EspChams and Fluent.Options.EspChams.Value then
                hl.Adornee = char
                hl.FillColor = baseColor
                hl.Enabled = true
            else
                hl.Enabled = false
            end

            -- 距离显示
            if Fluent.Options.EspDistance and Fluent.Options.EspDistance.Value then
                bb.Adornee = root
                bb.ExtentsOffset = Vector3_new(0, -(s.Y * 1.3), 0)
                tagLabel.Text = string.format("%d 格", distance)
                tagLabel.TextColor3 = currentTarget and targetCol or Color3_fromRGB(255, 255, 255)
                bb.Enabled = true
            else
                bb.Enabled = false
            end
        else
            hl.Enabled = false
            bb.Enabled = false
            for _, pair in pairs(edges) do
                local name = pair[1] .. pair[2]
                local c = cache[name]
                if c then c.m.Visible, c.o.Visible = false, false end
            end
        end
    end

    local conn = main_utils.RunService.RenderStepped:Connect(step)
    espObjects[p] = {folder = g, connection = conn}
end

-- 移除玩家透视
local function remove3DEsp(p)
    if espObjects[p] then
        espObjects[p].connection:Disconnect()
        if espObjects[p].folder then espObjects[p].folder:Destroy() end
        espObjects[p] = nil
    end
end

