function toggleIsland(expand)
    isExpanded = expand
    if expand then
        TweenService:Create(shadow, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
            Size = UDim2.new(0, 280, 0, 240)
        }):Play()
        islandCorner.CornerRadius = UDim.new(0, 24)
        starHolder.Visible = false
        musicIcon.Visible = false
        timeLabel.Visible = false
        divider.Visible = false
        fpsLabel.Visible = false
        showMainMenu()
        outsideClicker.Visible = true
    else
        TweenService:Create(shadow, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
            Size = UDim2.new(0, 200, 0, 46)
        }):Play()
        islandCorner.CornerRadius = UDim.new(1, 0)
        if isPlaying then
            starHolder.Visible = false
            musicIcon.Visible = true
        else
            starHolder.Visible = true
            musicIcon.Visible = false
        end
        timeLabel.Visible = true
        divider.Visible = true
        fpsLabel.Visible = true
        hideAllPanels()
        outsideClicker.Visible = false
    end
end

