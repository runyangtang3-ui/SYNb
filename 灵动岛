-- ============ 播放状态 ============
local isPlaying = false
local currentIndex = 0
local volLevels = {0, 0.25, 0.5, 0.75, 1}
local volIdx = 3

local function playByIndex(idx)
    if #songList == 0 then return end
    idx = ((idx - 1) % #songList) + 1
    currentIndex = idx
    local song = songList[idx]
    musicSound:Stop()
    musicSound.SoundId = "rbxassetid://" .. song[1]
    musicSound.TimePosition = 0
    musicSound:Play()
    isPlaying = true
    mpPlay.Text = "❚❚"
    mpNowPlaying.Text = "♪ " .. song[2]
    nowPlaying.Text = "♪ " .. song[2]
    -- 收起时显示音符图标
    if not isExpanded then
        starHolder.Visible = false
        musicIcon.Visible = true
        startMusicJump()
    end
end

local function playRandom()
    if #songList == 0 then return end
    playByIndex(math.random(#songList))
end

local function nextSong()
    if #songList == 0 then return end
    playByIndex(currentIndex + 1)
end

local function prevSong()
    if #songList == 0 then return end
    playByIndex(currentIndex - 1)
end

mpPlay.MouseButton1Click:Connect(function()
    if musicSound.SoundId == "" then playRandom() return end
    if isPlaying then
        musicSound:Pause()
        isPlaying = false
        mpPlay.Text = "▶"
        stopMusicJump()
    else
        musicSound:Resume()
        isPlaying = true
        mpPlay.Text = "❚❚"
        startMusicJump()
    end
end)

mpShuffle.MouseButton1Click:Connect(playRandom)
mpNext.MouseButton1Click:Connect(nextSong)
mpPrev.MouseButton1Click:Connect(prevSong)

mpVol.MouseButton1Click:Connect(function()
    volIdx = (volIdx % #volLevels) + 1
    musicSound.Volume = volLevels[volIdx]
    mpVol.Text = "🔊 音量 " .. math.floor(volLevels[volIdx] * 100) .. "%"
end)

