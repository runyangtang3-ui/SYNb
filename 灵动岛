-- ============ 拖动 ============
local dragging = false
local dragStart, startPos, dragMoved = nil, nil, false

shadow.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        if isExpanded then
            local hit = playerGui:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y)
            for _, obj in ipairs(hit) do
                if obj:IsA("TextButton") or obj:IsA("TextBox") then return end
            end
        end
        dragging = true
        dragMoved = false
        dragStart = input.Position
        startPos = shadow.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                if not dragMoved then
                    toggleIsland(not isExpanded)
                end
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        if delta.Magnitude > 4 then dragMoved = true end
        shadow.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

