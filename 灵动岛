local musicJumpConn = nil

local function startMusicJump()
    if musicJumpConn then musicJumpConn:Disconnect() end
    local t = 0
    musicJumpConn = RunService.RenderStepped:Connect(function(dt)
        if not musicIcon.Visible then return end
        t = t + dt
        local jump = math.abs(math.sin(t * 6)) * 6
        local scale = 1 + math.abs(math.sin(t * 6)) * 0.3
        musicIcon.Position = UDim2.new(0, 7, 0.5, -15 - jump)
        musicIcon.TextSize = 20 * scale
        local hue = (t * 0.3) % 1
        musicIcon.TextColor3 = Color3.fromHSV(hue, 0.5, 1)
    end)
end

local function stopMusicJump()
    if musicJumpConn then
        musicJumpConn:Disconnect()
        musicJumpConn = nil
    end
    musicIcon.Position = UDim2.new(0, 7, 0.5, -15)
    musicIcon.TextSize = 20
end

