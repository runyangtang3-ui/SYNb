local function hookParryResult()
    local candidates = {}
    local tool = getParryTool()
    if tool then
        local r = tool:FindFirstChild("parryResult") or tool:FindFirstChild("ParryResult")
        if r then table.insert(candidates, r) end
    end
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local items = remotes and remotes:FindFirstChild("Items")
        local dagger = items and (items:FindFirstChild("Parrying Dagger") or items:FindFirstChild("Parry Dagger"))
        if dagger then
            local r = dagger:FindFirstChild("parryResult") or dagger:FindFirstChild("ParryResult")
            if r then table.insert(candidates, r) end
        end
    end)
    local r2 = ReplicatedStorage:FindFirstChild("parryResult", true) or ReplicatedStorage:FindFirstChild("ParryResult", true)
    if r2 then table.insert(candidates, r2) end
    for _, result in ipairs(candidates) do
        if result:IsA("RemoteEvent") and not parryHookedResults[result] then
            parryHookedResults[result] = true
            result.OnClientEvent:Connect(function(a, b)
                local cd
                if type(a) == "number" then cd = a
                elseif type(b) == "number" then cd = b end
                if not cd then
                    local success = (a == true) or (type(b) == "boolean" and b == true)
                    cd = success and 90 or 60
                end
                parryCooldownEnd = tick_() + cd
            end)
        end
    end
end

