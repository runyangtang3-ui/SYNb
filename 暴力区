function L.fitFloatingButton(btn, label, baseSize)
    local size = baseSize or 18
    local chars = 0
    pcall(function() chars = utf8.len(label) or 0 end)
    if chars == 0 then chars = math.floor(#label / 3) end
    if chars > 3 then size = 14 end
    btn.TextSize = size
    local w = 60
    local ok, bounds = pcall(function()
        return game:GetService("TextService"):GetTextSize(label, size, btn.Font, Vector2.new(500, 200))
    end)
    if ok and bounds then w = math.max(60, math.ceil(bounds.X) + 24)
    elseif chars > 3 then w = 60 + chars * 10 end
    btn.Size = UDim2.new(0, w, 0, 60)
    return w
end

function L.createFloatingButton(guiName, text, pos, textSize, onClick)
    local sg = Instance.new("ScreenGui")
    sg.Name = guiName
    sg.ResetOnSpawn = false
    sg.Parent = getPlayerGui()
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 60, 0, 60)
    btn.Position = pos
    btn.BackgroundColor3 = Library.Scheme.MainColor
    btn.BackgroundTransparency = 0.2
    btn.BorderSizePixel = 0
    local finalText = text
    pcall(function()
        local tt = getgenv and getgenv().TranslateText
        if type(tt) == "function" then finalText = tt(text) end
    end)
    btn.Text = finalText
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    btn.Parent = sg
    L.fitFloatingButton(btn, finalText, textSize)
    btn.Active = true
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = btn
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(225, 225, 232)
    stroke.Thickness = 2.5
    stroke.Transparency = 0.3
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = btn
    local dragging, moved, dragStart, startPos = false, false, nil, nil
    local conns = {}
    table.insert(conns, btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true moved = false dragStart = input.Position startPos = btn.Position
        end
    end))
    table.insert(conns, UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            if (input.Position - dragStart).Magnitude > 4 then moved = true end
            local delta = input.Position - dragStart
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))
    table.insert(conns, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end))
    table.insert(conns, sg.Destroying:Connect(function()
        for _, c in conns do pcall(function() c:Disconnect() end) end
    end))
    btn.MouseButton1Click:Connect(function()
        if moved then return end
        onClick()
    end)
    return sg, btn
end

