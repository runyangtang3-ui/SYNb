local function isKiller(plr)
    if plr == LocalPlayer then return false end
    if plr:GetAttribute("Role") == "Killer" or plr:GetAttribute("IsKiller") == true then return true end
    local char = plr.Character
    if char and (char:GetAttribute("Role") == "Killer" or char:GetAttribute("IsKiller") == true) then return true end
    local team = plr.Team
    if team then
        local t = team.Name:lower()
        if t:find("killer") or t:find("slasher") or t:find("hunter") then return true end
    end
    return false
end

local function canParry()
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if char:GetAttribute("Knocked") == true then return false end
    if char:GetAttribute("IsHooked") == true then return false end
    if char:GetAttribute("IsCarried") == true then return false end
    return true
end

local function inParryRange(targetChar)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end
    local tRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not tRoot then return false end
    return (tRoot.Position - myRoot.Position).Magnitude <= ParrySettings.Range
end

local function tryParry(targetChar)
    if not ParrySettings.Enabled then return end
    if targetChar and ParrySettings.IgnoreFrenzy and isFrenzyKiller(targetChar) then return end
    if not canParry() then return end
    if tick_() < parryCooldownEnd then return end
    if targetChar then
        if not inParryRange(targetChar) then return end
        if not hasLineOfSight(targetChar) then return end
    end
    doParry()
end

local parryMonitored = setmetatable({}, {__mode = "k"})
local function monitorParryCharacter(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local function hookAnimator(animator)
        if not animator or parryMonitored[animator] then return end
        parryMonitored[animator] = true
        animator.AnimationPlayed:Connect(function(track)
            if not ParrySettings.Enabled then return end
            local prio = track.Priority
            if not track.Looped and (prio == Enum.AnimationPriority.Action
                or prio == Enum.AnimationPriority.Action2
                or prio == Enum.AnimationPriority.Action3
                or prio == Enum.AnimationPriority.Action4) then
                tryParry(char)
            end
        end)
    end
    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then hookAnimator(animator) end
    hum.ChildAdded:Connect(function(c) if c:IsA("Animator") then hookAnimator(c) end end)
end

