local function playerESPIsKiller(plr)
    if plr == LocalPlayer then return false end
    if plr:GetAttribute("Role") == "Killer" or plr:GetAttribute("IsKiller") == true then return true end
    local ch = plr.Character
    if ch and (ch:GetAttribute("Role") == "Killer" or ch:GetAttribute("IsKiller") == true) then return true end
    local team = plr.Team
    if team then
        local t = team.Name:lower()
        if t:find("killer") or t:find("slasher") or t:find("hunter") or t:find("monster") then return true end
    end
    return false
end

local function playerESPGetHealthState(plr)
    local ch = plr.Character
    if not ch then return "无" end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum then return "无" end
    if ch:GetAttribute("IsHooked") == true then return "挂钩中" end
    if ch:GetAttribute("Knocked") == true then return "倒地" end
    if ch:GetAttribute("IsCarried") == true then return "被扛起" end
    if hum.Health < hum.MaxHealth then return "受伤" end
    return "健康"
end

local function playerESPGetHookCount(plr)
    local ch = plr.Character
    if ch then
        local c = ch:GetAttribute("HookCount")
        if c ~= nil then return tonumber(c) or 0 end
        local v = ch:FindFirstChild("HookCount")
        if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then return tonumber(v.Value) or 0 end
    end
    local ws = workspace:FindFirstChild("Players")
    if ws then
        local folder = ws:FindFirstChild(plr.Name)
        if folder then
            local c = folder:GetAttribute("HookCount")
            if c ~= nil then return tonumber(c) or 0 end
            local v = folder:FindFirstChild("HookCount")
            if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then return tonumber(v.Value) or 0 end
        end
    end
    return 0
end

local function playerESPGetSelectedKiller(plr)
    local ch = plr.Character
    if ch then
        local c = ch:GetAttribute("SelectedKiller")
        if c ~= nil and c ~= "" then return tostring(c) end
        local v = ch:FindFirstChild("SelectedKiller")
        if v and v:IsA("StringValue") then
            local val = tostring(v.Value)
            if val ~= "" and val ~= "None" then return val end
        end
    end
    local c2 = plr:GetAttribute("SelectedKiller")
    if c2 ~= nil and c2 ~= "" then return tostring(c2) end
    local v2 = plr:FindFirstChild("SelectedKiller")
    if v2 and v2:IsA("StringValue") then
        local val = tostring(v2.Value)
        if val ~= "" and val ~= "None" then return val end
    end
    return "无"
end

