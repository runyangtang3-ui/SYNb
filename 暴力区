local function findPoint(gen)
    for _, c in ipairs(gen:GetDescendants()) do
        local n = c.Name:lower()
        if n:find("generatorpoint") and c:IsA("BasePart") then return c end
    end
    for _, c in ipairs(gen:GetDescendants()) do
        if c:IsA("BasePart") and c.Name:lower():find("point") then return c end
    end
    return gen.PrimaryPart or gen:FindFirstChildWhichIsA("BasePart")
end

local function getAllGens()
    local list = {}
    local seen = {}
    local function add(gen)
        if gen and gen:IsA("Model") and not seen[gen] then
            seen[gen] = true
            if not isCompleted(gen) then list[#list + 1] = gen end
        end
    end
    local map = workspace:FindFirstChild("Map")
    if map then
        for _, name in ipairs({"Generators", "Gens", "Generator"}) do
            local folder = map:FindFirstChild(name)
            if folder then
                for _, gen in ipairs(folder:GetChildren()) do
                    if gen.Name:lower():find("generat") then add(gen) end
                end
            end
        end
        local obj = map:FindFirstChild("Objective")
        if obj then
            for _, name in ipairs({"Generators", "Gens"}) do
                local sub = obj:FindFirstChild(name)
                if sub then
                    for _, gen in ipairs(sub:GetChildren()) do
                        if gen.Name:lower():find("generat") then add(gen) end
                    end
                end
            end
        end
    end
    local wsGen = workspace:FindFirstChild("Generators")
    if wsGen then
        for _, gen in ipairs(wsGen:GetChildren()) do
            if gen.Name:lower():find("generat") then add(gen) end
        end
    end
    if #list == 0 then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj.Name:lower():find("generat") then add(obj) end
        end
    end
    return list
end

local function findNearestGen()
    local char = LocalPlayer.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestDist = nil, math.huge
    for _, gen in ipairs(getAllGens()) do
        local part = gen.PrimaryPart or gen:FindFirstChildWhichIsA("BasePart")
        if part then
            local d = (part.Position - root.Position).Magnitude
            if d < bestDist then bestDist = d best = gen end
        end
    end
    return best
end

