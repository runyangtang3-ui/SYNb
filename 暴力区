local function doParry()
    local now = tick_()
    if now - parryLastParry < parryTriggerCooldown then return end
    if now < parryCooldownEnd then return end
    local tool = equipParryTool()
    if not tool then return end
    parryLastParry = now
    parryCooldownEnd = tick_() + parryCooldownValue
    local remote = getParryRemote()
    if remote then
        pcall(function()
            if remote:IsA("RemoteEvent") then remote:FireServer()
            elseif remote:IsA("RemoteFunction") then remote:InvokeServer() end
        end)
