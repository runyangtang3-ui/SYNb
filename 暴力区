local function fetchWithTimeout(timeout, fn)
    local done = false
    local result = nil
    task.spawn(function()
        local ok, res = pcall(fn)
        if ok then result = res end
        done = true
    end)
    local t0 = osClock()
    while not done and (osClock() - t0) < timeout do task.wait(0.05) end
    return result
end

