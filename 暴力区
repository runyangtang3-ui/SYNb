local espEffects = {}

local function removeESPEffects(obj)
    local e = espEffects[obj]
    if e then
        if e.tag then pcall(function() e.tag:Destroy() end) end
        if e.highlight then pcall(function() e.highlight:Destroy() end) end
        espEffects[obj] = nil
    end
end

local function collectESPTargets()
    local result = { Generator = {}, Pallet = {}, Hook = {}, Vault = {}, Gate = {}, SCP = {} }
    local anyEnabled = false
    for _, v in pairs(espEnabled) do if v then anyEnabled = true break end end
    if not anyEnabled then return result end
    local map = workspace:FindFirstChild("Map") or workspace
    for _, obj in ipairs(map:GetDescendants()) do
        if obj:IsA("Model") then
            local hasPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if hasPart then
                local n = obj.Name:lower()
                if n:find("generat") then table.insert(result.Generator, obj)
                elseif n:find("pallet") then table.insert(result.Pallet, obj)
                elseif n:find("hook") then table.insert(result.Hook, obj)
                elseif n:find("vault") or n:find("window") then table.insert(result.Vault, obj)
                elseif n:find("gate") or n:find("door") then table.insert(result.Gate, obj)
                elseif n:find("scp") then table.insert(result.SCP, obj)
                end
            end
        end
    end
    return result
end

local function createESPHighlight(model, color)
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.FillTransparency = 0.7
    hl.OutlineColor = color
    hl.OutlineTransparency = 0.7
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = model
    hl.Parent = model
    return hl
end

local function createESPTag(model, typeKey)
    local config = ESP_TYPES[typeKey]
    local attachPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not attachPart then return nil, nil end
    local tag = Instance.new("BillboardGui")
    tag.Size = UDim2.new(0, 200, 0, 90)
    tag.StudsOffset = v3new(0, 3, 0)
    tag.AlwaysOnTop = true
    tag.Adornee = attachPart
    tag.Parent = getESPTagHolder() or model
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = config.name
    label.TextColor3 = config.highlightColor
    label.TextTransparency = 0.3
    label.TextWrap = true
    label.TextWrapped = true
    label.RichText = true
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextStrokeTransparency = 0.5
    label.TextStrokeColor3 = c3rgb(0, 0, 0)
    label.Parent = tag
    return tag, label
end

local function espAttrNum(obj, names)
    for _, n in ipairs(names) do
        local a = obj:GetAttribute(n)
        if type(a) == "number" then return a end
        local v = obj:FindFirstChild(n)
        if v and v:IsA("ValueBase") and type(v.Value) == "number" then return v.Value end
    end
    return nil
end

local function espToPct(n)
    if type(n) ~= "number" then return 0 end
    if n > 0 and n <= 1.01 then return mathFloor(n * 100) end
    return mathFloor(n)
end

local function getGenProgress(obj)
    return espToPct(espAttrNum(obj, { "RepairProgress", "Progress", "repairProgress" }))
end

local function getGenRepairCount(obj)
    local n = espAttrNum(obj, { "PlayersRepairingCount", "RepairingCount", "Repairing", "repairingCount" })
    return mathFloor(n or 0)
end

local function getGateProgress(obj)
    local n = espAttrNum(obj, { "ActivationProgress", "Progress", "OpenedProgress" })
    if n == nil then
        local lever = obj:FindFirstChild("ExitLever", true) or obj:FindFirstChild("ExitLever")
        if lever then
            n = espAttrNum(lever, { "ActivationProgress", "Progress" })
            if n == nil then
                local main = lever:FindFirstChild("Main")
                if main then n = espAttrNum(main, { "ActivationProgress", "Progress" }) end
            end
        end
    end
    return espToPct(n)
end

local HOOK_OCCUPIED_COLOR = c3rgb(255, 60, 60)

local function isHookOccupied(hook)
    local pos = nil
    if hook:IsA("BasePart") then
        pos = hook.Position
    else
        local p = hook.PrimaryPart or hook:FindFirstChildWhichIsA("BasePart")
        if p then pos = p.Position end
    end
    if not pos then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local ch = plr.Character
            local hooked = ch:GetAttribute("IsHooked")
            if hooked == nil then
                local v = ch:FindFirstChild("IsHooked")
                if v and v:IsA("ValueBase") then hooked = v.Value end
            end
            if hooked == true then
                local hrp = ch:FindFirstChild("HumanoidRootPart")
                    or ch:FindFirstChild("UpperTorso")
                    or ch:FindFirstChild("Torso")
                if hrp and (hrp.Position - pos).Magnitude <= 15 then
                    return true
                end
            end
        end
    end
    return false
end

local function updateESPLabels()
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myPos = myRoot.Position
    for obj, e in pairs(espEffects) do
        if not obj.Parent then removeESPEffects(obj) continue end
        if e.label and e.tag and e.tag.Adornee and e.tag.Adornee.Parent then
            local dist = (e.tag.Adornee.Position - myPos).Magnitude
            local distStr = strFormat('<font size="11">[%d]</font>', mathFloor(dist))
            local baseName = ESP_TYPES[e.typeKey].name
            local baseColor = ESP_TYPES[e.typeKey].highlightColor
            local labelColor = baseColor
            local text

            if e.typeKey == "Generator" then
                text = strFormat('修机人数: %d\n修机进度: %d%%\n%s\n%s',
                    getGenRepairCount(obj), getGenProgress(obj), baseName, distStr)
            elseif e.typeKey == "Gate" then
                text = strFormat('开门进度: %d%%\n%s\n%s',
                    getGateProgress(obj), baseName, distStr)
            elseif e.typeKey == "Hook" then
                if isHookOccupied(obj) then
                    labelColor = HOOK_OCCUPIED_COLOR
                    text = strFormat('<font color="#ff3c3c">%s\n已被挂</font>\n%s', baseName, distStr)
                    if e.highlight and e.highlight.Parent then
                        e.highlight.FillColor = HOOK_OCCUPIED_COLOR
                        e.highlight.OutlineColor = HOOK_OCCUPIED_COLOR
                    end
                else
                    text = strFormat('%s\n%s', baseName, distStr)
                    if e.highlight and e.highlight.Parent then
                        e.highlight.FillColor = baseColor
                        e.highlight.OutlineColor = baseColor
                    end
                end
            else
                text = strFormat('%s\n%s', baseName, distStr)
            end

            if e.label.Text ~= text then e.label.Text = text end
            if e.label.TextColor3 ~= labelColor then e.label.TextColor3 = labelColor end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.3)
        pcall(function()
            local targets = collectESPTargets()
            local allTargets = {}
            for typeKey, list in pairs(targets) do
                if espEnabled[typeKey] then
                    for _, obj in ipairs(list) do allTargets[obj] = typeKey end
                end
            end
            for obj in pairs(espEffects) do
                if not allTargets[obj] then removeESPEffects(obj) end
            end
            for obj, typeKey in pairs(allTargets) do
                if not espEffects[obj] then
                    local config = ESP_TYPES[typeKey]
                    local tag, label = createESPTag(obj, typeKey)
                    local hl = createESPHighlight(obj, config.highlightColor)
                    espEffects[obj] = { tag = tag, label = label, highlight = hl, typeKey = typeKey }
                end
            end
        end)
    end
end)

