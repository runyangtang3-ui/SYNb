local parryRayParams = RaycastParams.new()
parryRayParams.FilterType = Enum.RaycastFilterType.Exclude
parryRayParams.IgnoreWater = true

local function buildParryRayFilter(targetChar)
    local filter = {}
    local myChar = LocalPlayer.Character
    if myChar then table.insert(filter, myChar) end
    if targetChar then table.insert(filter, targetChar) end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character ~= targetChar then
            table.insert(filter, plr.Character)
        end
    end
    return filter
end

local function hasLineOfSight(targetChar)
    if not ParrySettings.WallCheck then return true end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local tRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not tRoot then return false end
    parryRayParams.FilterDescendantsInstances = buildParryRayFilter(targetChar)
    local myPos = myRoot.Position
    local tPos = tRoot.Position
    local rayPairs = {
        { myPos + v3new(0, 0.5, 0), tPos + v3new(0, 0.5, 0) },
        { myPos + v3new(0, 2, 0),   tPos + v3new(0, 2, 0) },
        { myPos + v3new(0, 0, 0),   tPos + v3new(0, 1.5, 0) },
    }
    for _, pair in ipairs(rayPairs) do
        local origin = pair[1]
        local dir = pair[2] - origin
        local result = workspace:Raycast(origin, dir, parryRayParams)
        if not result then return true end
    end
    return false
end

local function isFrenzyKiller(targetChar)
    if not targetChar then return false end
    if targetChar:GetAttribute("Frenzy") == true then return true end
    local plr = Players:GetPlayerFromCharacter(targetChar)
