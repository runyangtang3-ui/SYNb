function L.fixInputColors(root)
    root = root or (Library and Library.ScreenGui)
    if not root then return end
    local scheme = Library.Scheme
    local field = scheme.MainColor:Lerp(Color3.new(1, 1, 1), 0.18)
    local font = scheme.FontColor
    local function paint(inst)
        if inst:IsA("TextBox") then
            inst.BackgroundColor3 = field
            inst.BackgroundTransparency = 0
            inst.TextColor3 = font
            pcall(function() inst.PlaceholderColor3 = font:Lerp(field, 0.45) end)
        elseif (inst:IsA("Frame") or inst:IsA("TextButton"))
            and inst.Name:lower():find("dropdown", 1, true) then
            inst.BackgroundColor3 = field
            inst.BackgroundTransparency = 0
            if inst:IsA("TextButton") then inst.TextColor3 = font end
            for _, child in inst:GetDescendants() do
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    child.TextColor3 = font
                end
            end
        end
    end
    for _, inst in root:GetDescendants() do pcall(paint, inst) end
end

task.defer(function()
    L.fixInputColors()
    if Library.ScreenGui then
        Library.ScreenGui.DescendantAdded:Connect(function(inst)
            task.defer(function() L.fixInputColors(inst) end)
        end)
    end
    local token = 0
    local function recolorSoon()
        token = token + 1
        local mine = token
        task.delay(0.4, function() if mine == token then L.fixInputColors() end end)
    end
    for _, key in { "MainColor", "BackgroundColor", "FontColor" } do
        if Options[key] and Options[key].OnChanged then
            Options[key]:OnChanged(recolorSoon)
        end
    end
end)

