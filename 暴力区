local function buildPlayerESPEffect(plr, pChar, pRoot, killer)
    local color = killer and KILLER_COLOR or SURVIVOR_COLOR
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = color
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = pChar
    hl.Parent = getPlayerESPHolder()

    local tag, label = nil, nil
    local holder = getPlayerESPTagHolder()
    if holder then
        tag = Instance.new("BillboardGui")
        tag.Size = UDim2.new(0, 200, 0, 50)
        tag.StudsOffset = v3new(0, 5.5, 0)
        tag.AlwaysOnTop = true
        tag.Adornee = pRoot
        tag.Parent = holder
        label = Instance.new("TextLabel")
        label.Size = UDim2.new(0, 200, 0, 50)
        label.BackgroundTransparency = 1
        label.Text = ""
        label.TextColor3 = color
        label.TextTransparency = 0.15
        label.RichText = true
        label.TextWrap = true
        label.TextWrapped = true
        label.Font = Enum.Font.GothamBold
        label.TextSize = 14
        label.TextStrokeTransparency = 0.3
        label.TextStrokeColor3 = c3rgb(0, 0, 0)
        label.Parent = tag
    end
    return { highlight = hl, tag = tag, label = label, isKiller = killer, character = pChar, root = pRoot }
end

task.spawn(function()
    while true do
        task.wait(0.15)
        local char = LocalPlayer.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        local myPos = myRoot and myRoot.Position

        for plr in pairs(playerESPEffects) do
            if not plr or not plr.Parent or not Players:FindFirstChild(plr.Name) then
                removePlayerESPEffect(plr)
            end
        end

        for _, plr in ipairs(Players:GetPlayers()) do
            pcall(function()
                if plr == LocalPlayer then
                    removePlayerESPEffect(plr)
                    return
                end

                local pChar = plr.Character
                local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
                local pHum = pChar and pChar:FindFirstChildOfClass("Humanoid")

                if not pChar or not pRoot or not pHum or pHum.Health <= 0 then
                    removePlayerESPEffect(plr)
                    return
                end

                local killer = playerESPIsKiller(plr)
                local want
                if killer then
                    want = PlayerESPSettings.KillerHighlight or PlayerESPSettings.KillerName
                        or PlayerESPSettings.KillerDistance or PlayerESPSettings.KillerSelected
                else
                    want = PlayerESPSettings.SurvivorHighlight or PlayerESPSettings.SurvivorName
                        or PlayerESPSettings.SurvivorDistance or PlayerESPSettings.SurvivorHealth
                        or PlayerESPSettings.SurvivorHooks
                end

                if not want then
                    removePlayerESPEffect(plr)
                    return
                end

                local e = playerESPEffects[plr]
                if e and (e.character ~= pChar or e.isKiller ~= killer or not e.highlight or not e.highlight.Parent) then
                    removePlayerESPEffect(plr)
                    e = nil
                end

                if not e then
                    e = buildPlayerESPEffect(plr, pChar, pRoot, killer)
                    playerESPEffects[plr] = e
                end

                local color = killer and KILLER_COLOR or SURVIVOR_COLOR

                if e.highlight then
                    e.highlight.Adornee = pChar
                    e.highlight.FillColor = color
                    e.highlight.OutlineColor = color
                    local show = killer and PlayerESPSettings.KillerHighlight or PlayerESPSettings.SurvivorHighlight
                    e.highlight.FillTransparency = show and 0.5 or 1
                    e.highlight.OutlineTransparency = show and 0 or 1
                end

                if e.tag then e.tag.Adornee = pRoot end

                if e.label and myPos then
                    local dist = (pRoot.Position - myPos).Magnitude
                    local parts = {}
                    if killer then
                        if PlayerESPSettings.KillerName then parts[#parts + 1] = plr.DisplayName or plr.Name end
                        if PlayerESPSettings.KillerSelected then
                            local sel = playerESPGetSelectedKiller(plr)
                            if sel ~= "无" and sel ~= "None" and sel ~= "" then
                                parts[#parts + 1] = "杀手: " .. sel
                            end
                        end
                        if PlayerESPSettings.KillerDistance then parts[#parts + 1] = "[" .. mathFloor(dist) .. "米]" end
                    else
                        if PlayerESPSettings.SurvivorName then parts[#parts + 1] = plr.DisplayName or plr.Name end
                        if PlayerESPSettings.SurvivorHealth then parts[#parts + 1] = "状态: " .. playerESPGetHealthState(plr) end
                        if PlayerESPSettings.SurvivorHooks then
                            local hk = playerESPGetHookCount(plr)
                            if hk > 0 then parts[#parts + 1] = "挂钩: " .. hk end
                        end
                        if PlayerESPSettings.SurvivorDistance then parts[#parts + 1] = "[" .. mathFloor(dist) .. "米]" end
                    end
                    local text = table.concat(parts, "  ")
                    if e.label.Text ~= text then e.label.Text = text end
                    if e.label.TextColor3 ~= color then e.label.TextColor3 = color end
                    local newSize = getPlayerESPTextSize(dist)
                    if e.label.TextSize ~= newSize then e.label.TextSize = newSize end
                end
            end)
        end
    end
end)

