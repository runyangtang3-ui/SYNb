local function isInPerfectRange(lineRot, goalRot)
    local line = lineRot % 360
    local goal = goalRot % 360
    if line < 0 then line = line + 360 end
    if goal < 0 then goal = goal + 360 end
    local startRot = (goal + PERFECT_START) % 360
    local endRot = (goal + PERFECT_END) % 360
    if startRot > endRot then
        return line >= startRot or line <= endRot
    else
        return line >= startRot and line <= endRot
    end
end

local function startPerfectSkillCheck()
    if PerfectSkillCheck.Connection then return end
    PerfectSkillCheck.Enabled = true
    PerfectSkillCheck.Connection = RunService.RenderStepped:Connect(function()
        if not PerfectSkillCheck.Enabled then return end
        if not LocalPlayer.Character then return end
        local now = tick()
        if now - lastCheckTime < CHECK_INTERVAL then return end
        lastCheckTime = now
        local gui, isConsole = getSkillCheckGui()
        if not gui then lastGoalRot = nil lastClickedGoal = nil return end
        local check = gui:FindFirstChild("Check")
        if not check then return end
        local line = check:FindFirstChild("Line")
        local goal = check:FindFirstChild("Goal")
        if not line or not goal then return end
        local goalRot = goal.Rotation
        local lineRot = line.Rotation
        if lastGoalRot ~= goalRot then
            lastGoalRot = goalRot
            lastClickedGoal = nil
        end
        if PerfectSkillCheck.Instant then
            if lastClickedGoal ~= goalRot or (now - lastClickTime > 0.3) then
                lastClickedGoal = goalRot
                lastClickTime = now
                clickSkillCheck(isConsole)
            end
            return
        end
        if PerfectSkillCheck.HitRate and PerfectSkillCheck.HitRate < 100 then
            if math.random(1, 100) > PerfectSkillCheck.HitRate then return end
        end
        if PerfectSkillCheck.Mode == "完美点击" then
            if isInPerfectRange(lineRot, goalRot) then
                if lastClickedGoal ~= goalRot or (now - lastClickTime > 0.3) then
                    lastClickedGoal = goalRot
                    lastClickTime = now
                    clickSkillCheck(isConsole)
                end
            end
        else
            if lastClickedGoal ~= goalRot or (now - lastClickTime > 0.3) then
                lastClickedGoal = goalRot
                lastClickTime = now
                clickSkillCheck(isConsole)
            end
        end
    end)
end

local function stopPerfectSkillCheck()
    PerfectSkillCheck.Enabled = false
    if PerfectSkillCheck.Connection then
        PerfectSkillCheck.Connection:Disconnect()
        PerfectSkillCheck.Connection = nil
    end
    lastGoalRot = nil lastClickedGoal = nil
end

