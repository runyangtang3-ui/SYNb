            if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                task.defer(function() inst.TextTransparency = 0 end)
            end
        end))
        local lastTick = 0
        table.insert(L._themeWatchConns, RunService.Heartbeat:Connect(function()
            local now = osClock()
            if now - lastTick < 0.15 then return end
            lastTick = now
            for _, inst in sg:GetDescendants() do forceOpaque(inst) end
        end))
    end)
end

