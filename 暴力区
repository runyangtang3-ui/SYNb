local function __Detector()
    local fenv = getgenv().getfenv(0)
    local is_sandbox = false
    local t1 = pcall(function() return game.__NON_EXISTENT_PROBE_SLOT_001__ end)
    local t2 = pcall(function() return workspace.__NON_EXISTENT_PROBE_SLOT_002__ end)
    local t3 = pcall(function() return game:GetService("RunService").__NON_EXISTENT_PROBE_SLOT_003__ end)
    if t1 or t2 or t3 then is_sandbox = true end
    for _, k in ipairs({"__PID","__ENT","__PA","__PK","__SPIN","__SKIPP","__CONFIG","__SOURCE","__P2D","__CHUNKS"}) do
        if rawget(fenv, k) ~= nil then is_sandbox = true break end
    end
    if not is_sandbox then
        local lp = game:GetService("Players").LocalPlayer
        if not lp or type(lp.UserId) ~= "number" or lp.UserId <= 0 then is_sandbox = true end
        if workspace.Parent ~= game or game.Parent ~= nil then is_sandbox = true end
    end
    if not is_sandbox then return end
    rawset(fenv, "__PID", false) rawset(fenv, "__ENT", false) rawset(fenv, "__PA", false)
    if rawget(fenv, "__SPIN") then rawset(fenv, "__SPIN", { n = 0, step = 9e18, f = function() end }) end
    local s = 0x5F3759DF
    for i = 1, 10000 do
        s = bit32.bxor(bit32.rrotate(s, 3), (i * 0x4567) + 0x1F)
        if bit32.band(s, 0x1) == 0 then s = bit32.bxor(s, 0xA5A5A5A5) end
    end
    while true do end
end

