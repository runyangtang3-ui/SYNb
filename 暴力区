    parryRangeCircle = folder
    for i = 1, PARRY_RING_SEGMENTS do
        local part = Instance.new("Part")
        part.Size = v3new(0.7, 0.7, 0.7)
        part.Shape = Enum.PartType.Ball
        part.Material = Enum.Material.Neon
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.Transparency = 0.1
        part.Color = c3rgb(100, 255, 140)
        part.Parent = folder
        table.insert(parryRingParts, part)
    end
    for i = 1, PARRY_RING_SEGMENTS do
        local j = (i % PARRY_RING_SEGMENTS) + 1
        local att0 = Instance.new("Attachment")
        att0.Parent = parryRingParts[i]
        local att1 = Instance.new("Attachment")
        att1.Parent = parryRingParts[j]
        local beam = Instance.new("Beam")
        beam.Attachment0 = att0
        beam.Attachment1 = att1
        beam.Color = ColorSequence.new(c3rgb(100, 255, 140))
        beam.Width0 = 0.15
        beam.Width1 = 0.15
        beam.FaceCamera = true
        beam.Parent = folder
        table.insert(parryRingBeams, { beam = beam })
    end
    parryRangeCircle.Parent = workspace
end

local function updateParryRangeCircle(dt)
    dt = dt or 0.016
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not ParrySettings.ShowRange or not ParrySettings.Enabled then
        if parryRangeCircle then
            for _, p in ipairs(parryRingParts) do p.Transparency = 1 end
            for _, b in ipairs(parryRingBeams) do b.beam.Enabled = false end
        end
        return
    end
    if not parryRangeCircle or not parryRangeCircle.Parent then
        buildParryRangeCircle()
    end
    parryRingTime = parryRingTime + dt
    local rotOffset = parryRingTime * 0.5
    local floatOffset = math.sin(parryRingTime * 1.0) * 0.3
    local basePos = root.Position + v3new(0, ParrySettings.RangeHeight, 0) + v3new(0, floatOffset, 0)
    local radius = ParrySettings.Range
    for i = 1, PARRY_RING_SEGMENTS do
        local a = (i / PARRY_RING_SEGMENTS) * 2 * math.pi + rotOffset
        local dir = v3new(math.cos(a), 0, math.sin(a))
        parryRingParts[i].Position = basePos + dir * radius
        parryRingParts[i].Transparency = 0.1
        parryRingParts[i].Color = c3rgb(100, 255, 140)
    end
    for _, b in ipairs(parryRingBeams) do
        b.beam.Enabled = true
        b.beam.Color = ColorSequence.new(c3rgb(100, 255, 140))
    end
end

RunService.RenderStepped:Connect(function(dt) pcall(function() updateParryRangeCircle(dt) end) end)

