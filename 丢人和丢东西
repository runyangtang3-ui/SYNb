function Library:Unload()
	Library.Unloaded = true
	if LibWindow ~= nil then
		TryCall(LibWindow, "Destroy")
		local root = SafeIndex(LibWindow, "Root")
		if root ~= nil then
			pcall(function()
				root:Destroy()
			end)
		end
	end
end

function Library:OnUnload(callback)
	table.insert(UnloadCallbacks, callback)
end

function Library:Notify(title, content)
	pcall(function()
		WindUI:Notify({ Title = title, Content = content, Duration = 5 })
	end)
end

