function WindowWrap:AddTab(title, icon)
	local tab = nil
	local attempts = {
		function()
			return self._win:Tab({ Title = title, Icon = icon })
		end,
		function()
			return self._win:Tab({ Title = title, Icon = "circle" })
		end,
		function()
			return self._win:Tab({ Title = title })
		end,
	}
	for _, attempt in ipairs(attempts) do
		local ok, result = pcall(attempt)
		if ok and result ~= nil then
			tab = result
			break
		end
	end
	return setmetatable({ _tab = tab }, TabWrap)
end

