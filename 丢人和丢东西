-- 不同 WindUI 版本的元素方法名不完全一致，这里逐项尝试，失败也不报错
local function SafeIndex(obj, key)
	if obj == nil then
		return nil
	end
	local ok, value = pcall(function()
		return obj[key]
	end)
	if ok then
		return value
	end
	return nil
end

local function TryCall(obj, method, ...)
	local fn = SafeIndex(obj, method)
	if type(fn) ~= "function" then
		return false
	end
	local ok = pcall(fn, obj, ...)
	return ok
end

local function TryMethods(obj, methods, ...)
	for _, method in ipairs(methods) do
		if TryCall(obj, method, ...) then
			return true
		end
	end
	return false
end

-- ---------------------------------------------------------------------------
-- 选项状态：脚本逻辑统一通过 Options.xxx.Value / :SetValue() 读写
-- ---------------------------------------------------------------------------
local OptionState = {}
OptionState.__index = OptionState

local function NewOption(defaultValue)
	return setmetatable({ Value = defaultValue }, OptionState)
end

function OptionState:SetValue(value)
	self.Value = value
	if self._raw ~= nil then
		TryMethods(self._raw, { "Set", "SetValue", "SetState" }, value)
	end
end

function OptionState:GetValue()
	return self.Value
end

function OptionState:SetValues(values)
	self.Values = values
	if self._raw ~= nil then
		TryMethods(self._raw, { "Refresh", "SetValues", "Update" }, values)
	end
end

local function RegisterOption(key, state)
	Options[key] = state
	Toggles[key] = state
	return state
end

-- ---------------------------------------------------------------------------
-- 布局容器
-- ---------------------------------------------------------------------------
local function AddElement(container, kind, opts)
	local fn = SafeIndex(container, kind)
	if type(fn) ~= "function" then
		return nil
	end
	-- WindUI 不同版本分别使用 Desc / Description 作为说明字段，两者都传以兼容
	if opts.Desc ~= nil and opts.Description == nil then
		opts.Description = opts.Desc
	end
	local ok, result = pcall(fn, container, opts)
	if not ok then
		return nil
	end
	if result ~= nil then
		return result
	end
	return true
end

local Group = {}
Group.__index = Group

local function NewGroup(tab, title)
	local section = nil
	if type(SafeIndex(tab, "Section")) == "function" then
		local ok, result = pcall(function()
			return tab:Section({ Title = title })
		end)
		if ok and result ~= nil then
			section = result
		end
	end
	return setmetatable({ _tab = tab, _section = section, _title = title }, Group)
end

function Group:_Add(kind, opts)
	local element = AddElement(self._section, kind, opts)
	if element == nil then
		element = AddElement(self._tab, kind, opts)
	end
	return element
end

function Group:AddToggle(key, cfg)
	cfg = cfg or {}
	local state = NewOption(cfg.Default == nil and false or cfg.Default)
	state._raw = self:_Add("Toggle", {
		Title = cfg.Text or key,
		Desc = cfg.Desc,
		Value = state.Value,
		Default = state.Value,
		Callback = function(value)
			state.Value = value
			if cfg.Callback then
				cfg.Callback(value)
			end
		end,
	})
	return RegisterOption(key, state)
end

function Group:AddSlider(key, cfg)
	cfg = cfg or {}
	local state = NewOption(cfg.Default == nil and 0 or cfg.Default)
	local step = cfg.Step
	if step == nil and (cfg.Rounding or 0) == 0 then
		step = 1
	end
	state._raw = self:_Add("Slider", {
		Title = cfg.Text or key,
		Desc = cfg.Desc,
		Value = state.Value,
		Min = cfg.Min or 0,
		Max = cfg.Max or 100,
		Step = step,
		Rounding = cfg.Rounding,
		Callback = function(value)
			state.Value = value
			if cfg.Callback then
				cfg.Callback(value)
			end
		end,
	})
	if state._raw == nil then
		-- 老版本 WindUI 的滑动条参数以表格形式放在 Value 内
		state._raw = self:_Add("Slider", {
			Title = cfg.Text or key,
			Desc = cfg.Desc,
			Value = { Min = cfg.Min or 0, Max = cfg.Max or 100, Default = state.Value },
			Callback = function(value)
				state.Value = value
				if cfg.Callback then
					cfg.Callback(value)
				end
			end,
		})
	end
	return RegisterOption(key, state)
end

function Group:AddDropdown(key, cfg)
	cfg = cfg or {}
	local values = cfg.Values or {}
	local initial = cfg.Default
	if type(initial) == "number" then
		initial = values[initial] or values[1]
	elseif initial == nil then
		initial = values[1]
	end
	local state = NewOption(initial)
	state.Values = values
	state._raw = self:_Add("Dropdown", {
		Title = cfg.Text or key,
		Desc = cfg.Desc,
		Values = values,
		Value = initial,
		Default = initial,
		Multi = cfg.Multi or false,
		Searchable = cfg.Searchable,
		Callback = function(value)
			state.Value = value
			if cfg.Callback then
				cfg.Callback(value)
			end
		end,
	})
	return RegisterOption(key, state)
end

function Group:AddButton(cfg)
	cfg = cfg or {}
	return self:_Add("Button", {
		Title = cfg.Text or "按钮",
		Desc = cfg.Desc,
		Callback = function()
			if cfg.Func then
				cfg.Func()
			end
		end,
	})
end

function Group:AddDivider()
	if self:_Add("Divider", {}) == nil then
		return nil
	end
	return true
end

local LabelHandle = {}
LabelHandle.__index = LabelHandle

function LabelHandle:SetText(text)
	self.Text = text
	if self._raw ~= nil and self._raw ~= true then
		if not TryMethods(self._raw, { "SetTitle", "SetText", "Set" }, text) then
			local inner = SafeIndex(self._raw, "Title")
			if inner ~= nil and typeof(inner) == "Instance" then
				pcall(function()
					inner.Text = text
				end)
			end
		end
	end
end

function Group:AddLabel(text)
	local raw = self:_Add("Paragraph", { Title = text, Desc = "" })
	return setmetatable({ Text = text, _raw = raw }, LabelHandle)
end

function Group:AddKeybind(key, cfg)
	cfg = cfg or {}
	local state = NewOption(cfg.Default or "RightControl")
	state._raw = self:_Add("Keybind", {
		Title = cfg.Text or "菜单按键",
		Value = Enum.KeyCode.RightControl,
		Default = Enum.KeyCode.RightControl,
		Callback = function(value)
			local code = value
			if typeof(value) ~= "EnumItem" then
				code = Enum.KeyCode[value] or Enum.KeyCode.RightControl
			end
			state.Value = code
			if LibWindow ~= nil then
				TryCall(LibWindow, "SetToggleKey", code)
			end
		end,
	})
	return RegisterOption(key, state)
end

