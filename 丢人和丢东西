local function IsGuiObjectActuallyVisible(obj: GuiObject): boolean
	local cur: Instance? = obj
	while cur do
		if cur:IsA("GuiObject") then
			if not cur.Visible then
				return false
			end
		elseif cur:IsA("ScreenGui") then
			return cur.Enabled
		end
		cur = cur.Parent
	end
	return false
end

