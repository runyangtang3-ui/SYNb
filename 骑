--==============================================================
-- 飞行（无碰撞）
--==============================================================
local NoclipActive = false
local NoclipOriginalCollision = {}

local function setFlyNoclip(enabled)
	getCharacter()
	if enabled then
		if NoclipActive then return end
		NoclipOriginalCollision = {}
		if Character and Character.Parent then
			for _, part in ipairs(Character:GetDescendants()) do
				if part:IsA("BasePart") then
					NoclipOriginalCollision[part] = part.CanCollide
					part.CanCollide = false
				end
			end
		end
		NoclipActive = true
		return
	end
	if not NoclipActive then return end
	for part, originalValue in pairs(NoclipOriginalCollision) do
		if part and part.Parent then part.CanCollide = originalValue end
	end
	NoclipOriginalCollision = {}
	NoclipActive = false
end

local function refreshFlyNoclip()
	if not NoclipActive then return end
	getCharacter()
	if not Character or not Character.Parent then return end
	for _, part in ipairs(Character:GetDescendants()) do
		if part:IsA("BasePart") then
			if NoclipOriginalCollision[part] == nil then
				NoclipOriginalCollision[part] = part.CanCollide
			end
			part.CanCollide = false
		end
	end
end

local function flySegment(targetPosition, token)
	getCharacter()
	if not Character or not RootPart or not RootPart.Parent then return false, "角色未找到" end
	local start = RootPart.Position
	if not isValidPosition(start) or not isValidPosition(targetPosition) then return false, "坐标无效" end
	local distance = (targetPosition - start).Magnitude
	local duration = math.max(distance / math.max(FlySpeed, 1), 0.03)
	local started = os.clock()
	local from = Character:GetPivot()
	local target = CFrame.new(targetPosition, targetPosition + from.LookVector)

	while Running and FlyBusy and token == FlyCancelToken do
		getCharacter()
		refreshFlyNoclip()
		if not RootPart or not Character or not Character.Parent then return false, "角色丢失" end
		local alpha = math.clamp((os.clock() - started) / duration, 0, 1)
		Character:PivotTo(from:Lerp(target, alpha))
		RootPart.AssemblyLinearVelocity = Vector3.zero
		RootPart.AssemblyAngularVelocity = Vector3.zero
		if alpha >= 1 then return true end
		RunService.Heartbeat:Wait()
	end
	return false, "飞行已取消"
end

flyToTarget = function(model, afterEgg, stageFirst)
	if FlyBusy then return false, "飞行正忙" end
	model = resolveEggModel(model)
	if not model or not model.Parent or not model:IsDescendantOf(RenderedEggs) then return false, "蛋已不存在" end
	getCharacter()
	if not Character or not RootPart then return false, "角色未找到" end

	local hoverPosition = getEggHoverPosition(model)
	if not hoverPosition then return false, "蛋未就绪" end

	FlyBusy = true
	FlyCancelToken += 1
	local token = FlyCancelToken

	local isVolcanic = string.lower(model.Name) == "volcanic egg"
	local doStage = stageFirst == true or isVolcanic

	setFlyNoclip(true)
	showStatus("飞向 " .. model.Name, 2)

	local function finish(ok, reason)
		setFlyNoclip(false)
		FlyBusy = false
		return ok, reason
	end

	if doStage then
		local stagePosition = hoverPosition + Vector3.new(0, STAGE_HEIGHT, 0)
		local teleported, reason = safeTeleport(Character, RootPart, CFrame.new(stagePosition))
		if not teleported then
			showStatus("传送失败：" .. tostring(reason), 2)
			return finish(false, "中转传送失败：" .. tostring(reason))
		end
		showStatus("TP -> " .. model.Name, 0.6)
	end

	hoverPosition = getEggHoverPosition(model) or hoverPosition
	local success = flySegment(hoverPosition, token)
	if not success then
		showStatus("无法到达 " .. model.Name, 2)
		return finish(false, "无法到达蛋")
	end

	if model.Parent and model:IsDescendantOf(RenderedEggs) then
		local picked, how = instantPickupEgg(model)
		if picked then showStatus("拾取 -> " .. model.Name, 0.7)
		else showStatus("拾取失败：" .. tostring(how), 2) end
	end

	if afterEgg and FlyToPlotAfterEgg and token == FlyCancelToken then
		showStatus("等待 " .. model.Name .. " 被拾取", 3)
		local pickupDeadline = os.clock() + PICKUP_CONFIRM_TIMEOUT
		while Running and FlyBusy and token == FlyCancelToken and os.clock() < pickupDeadline do
			if not model.Parent or not model:IsDescendantOf(RenderedEggs) then break end
			RunService.Heartbeat:Wait()
		end
		if Running and FlyBusy and token == FlyCancelToken then
			local baseplate = getMyPlotBaseplate()
			if baseplate then
				local plotTarget = getBaseplateTopCFrame(baseplate)
				if plotTarget then
					local teleported, reason = safeTeleport(Character, RootPart, plotTarget)
					if not teleported then return finish(false, "返回地块传送失败：" .. tostring(reason)) end
				else
					return finish(false, "地块目标无效")
				end
			else
				return finish(false, "未找到我的地块")
			end
		end
	end

	return finish(true)
end

