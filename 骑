local function getESPDisplayText(model, rarityInfo, distance)
	local name = model and model.Name or "Egg"
	local rarity = rarityInfo and rarityInfo.Name or "Unknown"
	local text
	if ESPDisplayMode == "Rarity" then text = rarity
	elseif ESPDisplayMode == "Name" then text = name
	else text = name .. " [" .. rarity .. "]" end
	if distance then text ..= "\n[" .. math.floor(distance) .. " studs]" end
	return text
end

refreshESPDisplay = function()
	for model, esp in pairs(ESPs) do
		if model and model.Parent and esp and esp.Label then
			local info = getManualRarity(model.Name)
			esp.Label.Text = getESPDisplayText(model, info, nil)
		end
	end
end

local function createESP(model)
	if not model or not model:IsA("Model") or not model.Parent then return end
	if ESPs[model] then return end
	local root = getRootPart(model)
	if not root then return end
	local info = getManualRarity(model.Name)
	local color = info and info.Color or Color3.fromRGB(220, 220, 230)

	local bb = Instance.new("BillboardGui")
	bb.Name = "EggESP"
	bb.Adornee = root
	bb.AlwaysOnTop = true
	bb.Size = UDim2.new(0, 190, 0, 44)
	bb.StudsOffset = Vector3.new(0, 2.5, 0)
	bb.Enabled = GlobalESPEnabled and getEggTypeEnabled(model)
	bb.Parent = root

	local lbl = Instance.new("TextLabel")
	lbl.Name = "Info"
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 13
	lbl.TextColor3 = color
	lbl.TextStrokeTransparency = 0.15
	lbl.Text = getESPDisplayText(model, info)
	lbl.Parent = bb

	local hl
	if SHOW_HIGHLIGHT then
		hl = Instance.new("Highlight")
		hl.Name = "EggHighlight"
		hl.FillColor = color
		hl.OutlineColor = color
		hl.FillTransparency = 0.78
		hl.OutlineTransparency = 0.1
		hl.Adornee = model
		hl.Enabled = GlobalESPEnabled and getEggTypeEnabled(model)
		hl.Parent = model
	end

	ESPs[model] = { Billboard = bb, Label = lbl, Highlight = hl }
end

local function destroyESP(model)
	local esp = ESPs[model]
	if not esp then return end
	if esp.Billboard then esp.Billboard:Destroy() end
	if esp.Highlight then esp.Highlight:Destroy() end
	ESPs[model] = nil
end

