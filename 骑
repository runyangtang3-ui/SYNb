--===== 渐变边框（保留模板效果）=====
local function createGradientBorder(window)
	local mainFrame = window.UIElements.Main
	if not mainFrame then return nil end
	local existing = mainFrame:FindFirstChild("GradientStroke")
	if existing then existing:Destroy() end
	if not mainFrame:FindFirstChildOfClass("UICorner") then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 16)
		corner.Parent = mainFrame
	end
	local stroke = Instance.new("UIStroke")
	stroke.Name = "GradientStroke"
	stroke.Thickness = 2
	stroke.Color = Color3.new(1,1,1)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = mainFrame
	local grad = Instance.new("UIGradient")
	grad.Name = "GlowEffect"
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 214, 10)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 60))
	})
	grad.Rotation = 0
	grad.Parent = stroke
	return stroke
end

local borderAnimation
local borderEnabled = true
local animationSpeed = 3

local function startBorderAnimation(window, speed)
	local mainFrame = window.UIElements.Main
	if not mainFrame then return nil end
	local stroke = mainFrame:FindFirstChild("GradientStroke")
	if not stroke then return nil end
	local grad = stroke:FindFirstChild("GlowEffect")
	if not grad then return nil end
	local conn = RunService.Heartbeat:Connect(function()
		if not stroke or stroke.Parent == nil then conn:Disconnect() return end
		grad.Rotation = (tick() * speed * 60) % 360
	end)
	return conn
end

local function reinitializeBorder()
	if borderAnimation then borderAnimation:Disconnect() borderAnimation = nil end
	local s = createGradientBorder(Window)
	if s and borderEnabled then borderAnimation = startBorderAnimation(Window, animationSpeed) end
end

createGradientBorder(Window)
if borderEnabled then borderAnimation = startBorderAnimation(Window, animationSpeed) end

