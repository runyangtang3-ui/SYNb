local function registerModel(model)
	if not Running then return end
	if not model or not model:IsA("Model") or not model.Parent then return end
	if not model:IsDescendantOf(RenderedEggs) then return end
	model = resolveEggModel(model)
	if not EggEntries[model] then createEggRow(model) end
	if not ESPs[model] then createESP(model) end
	if updateSearch then updateSearch() end
end

--==============================================================
-- 搜索过滤
--==============================================================
updateSearch = function()
	local groupHasMatch = {}
	for model, entry in pairs(EggEntries) do
		if entry and entry.Model and entry.Frame and entry.Model.Parent then
			local name = string.lower(entry.Model.Name)
			local matches = SearchQuery == "" or string.find(name, SearchQuery, 1, true) ~= nil
			entry.Frame.Visible = matches
			if matches then groupHasMatch[entry.Group] = true end
		elseif entry and entry.Frame then
			entry.Frame.Visible = false
		end
	end
	for _, group in pairs(EggGroupFrames) do
		if SearchQuery == "" then
			group.Frame.Visible = true
		else
			group.Frame.Visible = groupHasMatch[group] == true
		end
	end
end

