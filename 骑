		repeat
			if not Running or not object.Parent or not object:IsDescendantOf(RenderedEggs) then return end
			if getRootPart(object) then break end
			task.wait(0.05)
		until os.clock() >= deadline
		if not Running or not object.Parent or not object:IsDescendantOf(RenderedEggs) then return end
		registerModel(object)
	end)
end

