-- 主循环
--==============================================================
task.spawn(function()
	while Running do
		getCharacter()
		local root = RootPart
		for model, esp in pairs(ESPs) do
			if not model or not model.Parent or not model:IsDescendantOf(RenderedEggs) then
				destroyESP(model)
				local entry = EggEntries[model]
				if entry then
					if entry.Frame then entry.Frame:Destroy() end
					local g = entry.Group
					if g then
						for i, r in ipairs(g.Rows) do
							if r == entry.Frame then table.remove(g.Rows, i) break end
						end
						g.CountLabel.Text = tostring(#g.Rows)
						if #g.Rows == 0 then
							g.Frame:Destroy()
							EggGroupFrames[g.Name] = nil
						end
					end
					EggEntries[model] = nil
				end
			else
				local eggRoot = getRootPart(model)
				if eggRoot then
					local distance = 0
					if root then distance = (root.Position - eggRoot.Position).Magnitude end
					local enabled = GlobalESPEnabled and getEggTypeEnabled(model)
					esp.Billboard.Enabled = enabled
					local info = getManualRarity(model.Name)
					local color = info and info.Color or Color3.fromRGB(220, 220, 230)
					esp.Label.TextColor3 = color
					if esp.Highlight then
						esp.Highlight.FillColor = color
						esp.Highlight.OutlineColor = color
						esp.Highlight.Enabled = enabled
					end
					esp.Label.Text = getESPDisplayText(model, info, root and distance or nil)
					local entry = EggEntries[model]
					if entry then
						if root then
							entry.Label.Text = model.Name .. " [" .. math.floor(distance) .. " studs]"
						else
							entry.Label.Text = model.Name
						end
					end
				end
			end
		end
		task.wait(UPDATE_RATE)
	end
end)

--==============================================================
-- 关闭逻辑
--==============================================================
shutdown = function()
	if not Running then return end
	Running = false
	AutoFarmEnabled = false
	AutoFarmToken += 1
	FlyCancelToken += 1
	FlyBusy = false
	for model in pairs(ESPs) do destroyESP(model) end
	for _, conn in pairs(Connections) do
		if conn then pcall(function() conn:Disconnect() end) end
	end
	if borderAnimation then borderAnimation:Disconnect() borderAnimation = nil end
end

Window:OnClose(function()
	if ConfigManager then
		local cfg = ConfigManager:CreateConfig(configName)
		cfg:Set("FlySpeed", FlySpeed)
		cfg:Set("ESPDisplayMode", ESPDisplayMode)
		cfg:Set("FlyToPlotAfterEgg", FlyToPlotAfterEgg)
		cfg:Set("SelectedRarities", SelectedRarities)
		cfg:Set("lastSave", os.date("%Y-%m-%d %H:%M:%S"))
		cfg:Save()
		print("[红星中心骑宠物] 配置已自动保存")
	end
end)

Window:OnDestroy(function()
	print("[红星中心骑宠物] 窗口已销毁")
	shutdown()
end)

